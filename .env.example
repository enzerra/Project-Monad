PRIVY_VERIFICATION_KEY=
YOUTUBE_API_KEY=
RELAYER_PRIVATE_KEY=
CHOICE_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPERATOR_API_KEY=
CRON_SECRET=
MAX_DAILY_COMMITS=50
# Public origin of the deployed app, e.g. https://hive.example
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
