# Leave Privy/Supabase unset together for the existing local cookie session.
# Google login requires all four Privy/Supabase fields plus the SQL migrations.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_MONAD_CONTRACT_ADDRESS=
# Copy the Privy app verification public key (PEM), with newlines escaped as \n.
PRIVY_VERIFICATION_KEY=
YOUTUBE_API_KEY=

# Local SQLite fallback only when Privy and Supabase are both unconfigured.
# Required for production without Supabase; ignored when Supabase is configured.
# In development the default is .vibe-data/vibe.sqlite; never commit that directory.
VIBE_STORE_PATH=
RELAYER_PRIVATE_KEY=
CHOICE_ENCRYPTION_KEY=
SUPABASE_URL=
# Server-only service-role key. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
OPERATOR_API_KEY=
CRON_SECRET=
MAX_DAILY_COMMITS=50
# Public origin of the deployed app, e.g. https://hive.example
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
