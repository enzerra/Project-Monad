{
  "name": "vibe-metropolis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "start:production": "node scripts/start-production.mjs",
    "check:deploy": "node --env-file=.env.local scripts/check-deploy.mjs",
    "check:deploy:local": "node --env-file=.env.local scripts/check-deploy.mjs --local",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contract": "node scripts/forge.mjs test",
    "compile:contract": "node scripts/forge.mjs build",
    "deploy:contract": "node --env-file=.env.local scripts/deploy-contract.mjs",
    "create:call": "node --env-file=.env.local scripts/create-call.mjs"
  },
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "overrides": {
    "ws@^8.0.0": "^8.22.0"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.46.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.5.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.38.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
